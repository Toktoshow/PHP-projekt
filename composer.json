{
    "name": "example/php-rest-api",
    "description": "Простой REST API на чистом PHP (PDO + SQLite)",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8000 -t public public/index.php"
    }
}
